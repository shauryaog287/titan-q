# Python bytecode
__pycache__/
*.pyc

# Runtime state rewritten every few seconds by the live system
dashboard_state.json
live_state.json

# Generated outputs (reproducible by re-running the scripts)
*.png
equity_curve_results.csv

# Local tool config (personal settings, not project code)
.claude.json
.claude/settings.local.json

# Python virtual environment (cloud sessions, built by .claude/hooks/session-start.sh)
.venv/

# Run logs
logs/

# Market data cache (re-downloadable; intraday archive grows daily)
data/

# Broker credentials: NEVER commit
angel_credentials.json
*credentials*.json
!angel_credentials.example.json
.env

# Paper trading account (live ledger; delete it to reset the account)
paper_account*.json
titanq_live.lock
